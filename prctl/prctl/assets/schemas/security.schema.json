{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Security Report",
  "type": "object",
  "required": ["pr", "conclusion", "findings"],
  "properties": {
    "pr": {"type": "string"},
    "conclusion": {"type": "string", "enum": ["pass", "fail"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "location",
          "problem",
          "evidence",
          "fix"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "category": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "problem": {"type": "string", "minLength": 3},
          "evidence": {"type": "string", "minLength": 3},
          "fix": {"type": "string", "minLength": 3},
          "status": {"type": "string", "enum": ["open", "fixed", "accepted"]},
          "disposition_note": {"type": "string"}
        }
      }
    }
  }
}
