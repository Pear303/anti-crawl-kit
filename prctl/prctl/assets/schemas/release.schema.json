{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Release Plan",
  "type": "object",
  "required": ["pr", "rollout", "rollback", "monitoring"],
  "properties": {
    "pr": {"type": "string"},
    "release_type": {
      "type": "string",
      "enum": ["service", "library", "cli"],
      "default": "service"
    },
    "flag": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "rollout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "percentage", "soak_hours"],
        "properties": {
          "stage": {"type": "string", "minLength": 1},
          "percentage": {"type": "integer", "minimum": 0, "maximum": 100},
          "soak_hours": {"type": "integer", "minimum": 0}
        }
      }
    },
    "rollback": {
      "type": "object",
      "required": ["steps", "verification"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "verification": {"type": "string", "minLength": 3}
      }
    },
    "monitoring": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
