{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Pack",
  "type": "object",
  "required": [
    "goal",
    "acceptance_criteria",
    "commands",
    "run_evidence",
    "impact",
    "security",
    "rollback"
  ],
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 10
    },
    "ui_change": {
      "type": "boolean",
      "default": true
    },
    "no_ui_reason": {
      "type": "string"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "result", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 3},
          "result": {"type": "string", "enum": ["PASS", "FAIL", "BLOCKED"]},
          "evidence": {"type": "string", "minLength": 3}
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "output"],
        "properties": {
          "command": {"type": "string", "minLength": 3},
          "output": {"type": "string", "minLength": 1}
        }
      }
    },
    "run_evidence": {
      "type": "object",
      "required": ["start_command", "screenshots", "logs"],
      "properties": {
        "start_command": {"type": "string", "minLength": 3},
        "screenshots": {
          "type": "array",
          "minItems": 0,
          "items": {"type": "string", "minLength": 1}
        },
        "logs": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "impact": {
      "type": "object",
      "required": ["affected_modules", "compatibility", "risk_notes"],
      "properties": {
        "affected_modules": {
          "type": "array",
          "items": {"type": "string"}
        },
        "compatibility": {"type": "string", "minLength": 3},
        "risk_notes": {"type": "string"}
      }
    },
    "security": {
      "type": "object",
      "required": ["secrets", "input_validation", "authz", "dependencies"],
      "properties": {
        "secrets": {"type": "string"},
        "input_validation": {"type": "string"},
        "authz": {"type": "string"},
        "dependencies": {"type": "string"}
      }
    },
    "rollback": {
      "type": "object",
      "required": ["flag", "steps", "verification"],
      "properties": {
        "flag": {"type": "string", "minLength": 1},
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "verification": {"type": "string", "minLength": 3},
        "data_reversible": {"type": "boolean"}
      }
    }
  }
}
