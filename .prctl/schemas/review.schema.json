{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Review Report",
  "type": "object",
  "required": ["pr", "round", "context", "conclusion", "findings"],
  "properties": {
    "pr": {"type": "string"},
    "round": {"type": "integer", "minimum": 1},
    "context": {"type": "string", "enum": ["fresh", "delta"]},
    "conclusion": {
      "type": "string",
      "enum": ["pass", "changes_requested", "blocked"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "category",
          "file",
          "line",
          "problem",
          "evidence",
          "disposition"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "severity": {"type": "string", "enum": ["P0", "P1", "P2"]},
          "category": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "problem": {"type": "string", "minLength": 3},
          "evidence": {"type": "string", "minLength": 3},
          "disposition": {
            "type": "string",
            "enum": ["fixed", "explained", "deferred", "wontfix"]
          },
          "disposition_note": {"type": "string"}
        }
      }
    },
    "filtered": {
      "type": "object",
      "properties": {
        "style": {"type": "integer", "minimum": 0},
        "redundancy": {"type": "integer", "minimum": 0},
        "other": {"type": "integer", "minimum": 0}
      }
    }
  }
}
